# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://aeo:aeo_password@localhost:5432/aeo?schema=public"

# ─── Redis (queues, cache, rate-limit) ──────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ─── Auth ───────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── Credential encryption (AES-256-GCM) ────────────────────
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# ─── Sending engine ─────────────────────────────────────────
# Public base URL the recipient's mail client can reach for open/click/unsub.
# In production this is your tracking domain (e.g. https://track.yourdomain.com).
APP_PUBLIC_URL="http://localhost:4000"
# Dispatcher scan cadence (ms) and IMAP reply poll cadence (ms)
DISPATCH_SCAN_MS=60000
REPLY_POLL_MS=300000

# ─── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
