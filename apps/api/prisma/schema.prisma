// Automated Email Outreach — Prisma schema
// Multi-tenant: every business table carries tenantId for row-level isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  SUB_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum MailProtocol {
  SMTP
  IMAP
  POP
}

enum MailboxStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum ImportStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  DONE
  FAILED
}

enum CampaignStatus {
  DRAFT
  PENDING
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  REJECTED
}

enum StepCondition {
  ALWAYS
  NO_REPLY
  OPENED
  NOT_OPENED
}

enum ScheduleStatus {
  PENDING
  APPROVED
  QUEUED
  SENT
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum EventType {
  SENT
  DELIVERED
  OPEN
  CLICK
  REPLY
  BOUNCE
  UNSUBSCRIBE
  COMPLAINT
}

enum ApprovalEntity {
  CAMPAIGN
  SCHEDULE
  SEQUENCE
  IMPORT
  SMTP
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  MANUAL
  COMPLAINT
}

enum EnrollmentStatus {
  ACTIVE
  REPLIED
  STOPPED
  COMPLETED
}

enum CohortStatus {
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

// ───────────────────────── Tenancy & Identity ─────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("free")
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  emailAccounts   EmailAccount[]
  contactLists    ContactList[]
  contacts        Contact[]
  suppressionList Suppression[]
  importJobs      ImportJob[]
  templates       EmailTemplate[]
  campaigns       Campaign[]
  messages        EmailMessage[]
  approvals       Approval[]
  activityLogs    ActivityLog[]
  creditAccounts  CreditAccount[]
  clients         Client[]
  cohorts         Cohort[]
  enrollments     Enrollment[]
}

model User {
  id             String     @id @default(uuid())
  tenantId       String
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  timezone       String     @default("UTC")
  twoFactorSecret String?
  avatarUrl      String?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions       UserPermission[]
  emailAccounts     EmailAccount[]
  contactLists      ContactList[]
  contacts          Contact[]
  importJobs        ImportJob[]
  templates         EmailTemplate[]
  campaigns         Campaign[]
  creditAccount     CreditAccount?
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  submittedApprovals Approval[] @relation("ApprovalSubmitter")
  reviewedApprovals  Approval[] @relation("ApprovalReviewer")
  activityLogs       ActivityLog[]

  // Sub-admin assignments
  assignmentsAsSubAdmin SubAdminAssignment[] @relation("SubAdmin")
  assignmentsAsUser     SubAdminAssignment[] @relation("AssignedUser")

  @@index([tenantId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  users       UserPermission[]
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model SubAdminAssignment {
  id               String   @id @default(uuid())
  subAdminId       String
  assignedUserId   String?
  assignedCampaignId String?
  createdAt        DateTime @default(now())

  subAdmin     User      @relation("SubAdmin", fields: [subAdminId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  campaign     Campaign? @relation(fields: [assignedCampaignId], references: [id], onDelete: Cascade)

  @@index([subAdminId])
}

// ───────────────────────── Mailboxes ─────────────────────────

model EmailAccount {
  id                   String        @id @default(uuid())
  tenantId             String
  userId               String
  label                String
  protocol             MailProtocol  @default(SMTP)
  smtpHost             String?
  smtpPort             Int?
  smtpSecure           Boolean       @default(true)
  imapHost             String?
  imapPort             Int?
  emailAddress         String
  smtpUsername         String?       // SMTP login when it differs from the From address (e.g. AWS SES AKIA… user)
  credentialsEncrypted String        // AES-256-GCM blob (SMTP password), never returned to client
  imapUsername         String?       // IMAP login when receiving lives on a different host than SMTP
  imapCredentialsEncrypted String?   // AES-256-GCM blob (IMAP password); falls back to SMTP creds when null
  status               MailboxStatus @default(PENDING)
  dailyLimit           Int           @default(200)
  warmupEnabled        Boolean       @default(true)
  sendSpeedSeconds     Int           @default(90)
  reputationScore      Int           @default(100)
  clientId             String?       // mailbox group: all mailboxes of a client form its sending pool
  rotationOrder        Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaigns Campaign[]
  messages  EmailMessage[]

  @@index([tenantId])
  @@index([userId])
  @@index([clientId])
}

// ───────────────────────── Contacts ─────────────────────────

model ContactList {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  name        String
  description String?
  clientId    String?  // owning client (null = shared/global)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members  ContactListMember[]
  campaigns Campaign[]

  @@index([tenantId])
  @@index([clientId])
}

model Contact {
  id           String        @id @default(uuid())
  tenantId     String
  userId       String
  email        String
  firstName    String?
  lastName     String?
  company      String?
  country      String?
  clientId     String?       // owning client (null = shared/global)
  customFields Json          @default("{}")
  status       ContactStatus @default(ACTIVE)
  dedupeHash   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lists    ContactListMember[]
  messages EmailMessage[]
  enrollments Enrollment[]

  @@unique([tenantId, dedupeHash])
  @@index([tenantId])
  @@index([email])
  @@index([clientId])
}

model ContactListMember {
  id        String @id @default(uuid())
  listId    String
  contactId String

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
}

model Suppression {
  id        String            @id @default(uuid())
  tenantId  String
  email     String
  reason    SuppressionReason
  createdAt DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model ImportJob {
  id         String       @id @default(uuid())
  tenantId   String
  userId     String
  filename   String
  listId     String?      // optional target list applied on approval
  clientId   String?      // owning client, propagated to imported contacts
  totalRows  Int          @default(0)
  validRows  Int          @default(0)
  dupRows    Int          @default(0)
  payload    Json         @default("[]") // staged rows; inserted on approval
  status     ImportStatus @default(PENDING)
  approvalId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ───────────────────────── Templates & Campaigns ─────────────────────────

model EmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  variables Json     @default("[]")
  clientId  String?  // owning client (null = shared/global)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaigns Campaign[]
  steps  CampaignStep[]
  sequenceSteps SequenceStep[]

  @@index([tenantId])
  @@index([clientId])
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  userId          String
  name            String
  clientLabel     String?
  clientId        String?
  emailAccountId  String?
  listId          String?
  templateId      String?
  status          CampaignStatus @default(DRAFT)
  timezone        String         @default("UTC")
  dailyLimit      Int            @default(200)
  sendSpeedSeconds Int           @default(90)
  startAt         DateTime?
  approvalId      String?
  creditsEstimate Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount?  @relation(fields: [emailAccountId], references: [id])
  list         ContactList?   @relation(fields: [listId], references: [id])
  template     EmailTemplate? @relation(fields: [templateId], references: [id])

  steps       CampaignStep[]
  schedules   Schedule[]
  messages    EmailMessage[]
  events      EmailEvent[]
  assignments SubAdminAssignment[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([clientId])
}

model CampaignStep {
  id         String        @id @default(uuid())
  campaignId String
  stepOrder  Int
  templateId String?
  waitDays   Int           @default(0)
  condition  StepCondition @default(ALWAYS)

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id])
  messages EmailMessage[]

  @@unique([campaignId, stepOrder])
}

model Schedule {
  id          String         @id @default(uuid())
  campaignId  String
  scheduledAt DateTime
  timezone    String         @default("UTC")
  status      ScheduleStatus @default(PENDING)
  approvalId  String?
  createdAt   DateTime       @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ───────────────────────── Sending & Events ─────────────────────────

model EmailMessage {
  id             String           @id @default(uuid())
  tenantId       String
  campaignId     String?
  stepId         String?
  contactId      String?
  emailAccountId String?
  direction      MessageDirection @default(OUTBOUND)
  messageId      String?          // RFC Message-ID
  inReplyTo      String?
  fromAddress    String?          // sender address for INBOUND mail
  subject        String?
  body           String?
  status         MessageStatus    @default(QUEUED)
  sentAt         DateTime?
  error          String?
  createdAt      DateTime         @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  step         CampaignStep? @relation(fields: [stepId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id])
  events       EmailEvent[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([status])
}

model EmailEvent {
  id         String    @id @default(uuid())
  messageId  String
  campaignId String?
  eventType  EventType
  meta       Json      @default("{}")
  occurredAt DateTime  @default(now())

  message  EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaign Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([eventType])
}

// ───────────────────────── Governance ─────────────────────────

model Approval {
  id             String         @id @default(uuid())
  tenantId       String
  entityType     ApprovalEntity
  entityId       String
  submittedById  String
  status         ApprovalStatus @default(PENDING)
  reviewerId     String?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy User   @relation("ApprovalSubmitter", fields: [submittedById], references: [id])
  reviewer    User?  @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([entityType, entityId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// ───────────────────────── Credits & Notifications ─────────────────────────

model CreditAccount {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String   @unique
  balance       Int      @default(0)
  pricePerEmail Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([tenantId])
}

model CreditTransaction {
  id              String   @id @default(uuid())
  creditAccountId String
  delta           Int
  reason          String
  referenceId     String?
  createdAt       DateTime @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── GRAPOUT cohort engine ─────────────────────────
// A Client (end-customer / exporter) owns a mailbox group (EmailAccounts with
// matching clientId) and a sequence. Each month a Cohort of contacts is enrolled
// and dripped: dailyBatchSize/day over batchWindowDays, advancing through the
// sequence steps every stageIntervalDays, rotating across the group's mailboxes.

model Client {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  status            String   @default("active")
  plan              String   @default("GROWTH")
  termStartedAt     DateTime @default(now())
  monthlyQuota      Int      @default(100) // fresh contacts per month
  dailyBatchSize    Int      @default(10)  // fresh sends per day
  batchWindowDays   Int      @default(10)  // days to spread a stage across
  stageIntervalDays Int      @default(10)  // gap between sequence stages
  followUpCount     Int      @default(4)   // follow-ups after the initial (capped)
  weekdaysOnly      Boolean  @default(true)
  sendWindowStart   Int      @default(9)    // send only between these hours (human-like)
  sendWindowEnd     Int      @default(17)
  stageIntervalJitterDays Int @default(2)   // ± random days on each follow-up gap
  autoCohortEnabled Boolean  @default(false) // auto-create a monthly cohort
  autoCohortListId  String?                  // source list for auto cohorts
  autoCohortDay     Int      @default(1)      // day-of-month to create it
  lastAutoCohortAt  DateTime?                 // guards once-per-month creation
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mailboxes     EmailAccount[]
  sequenceSteps SequenceStep[]
  cohorts       Cohort[]
  enrollments   Enrollment[]
  contacts      Contact[]
  contactLists  ContactList[]
  templates     EmailTemplate[]
  campaigns     Campaign[]

  @@index([tenantId])
}

model SequenceStep {
  id         String  @id @default(uuid())
  clientId   String
  stageOrder  Int    // 0 = initial, 1 = FU-1, 2 = FU-2, …
  templateId  String?
  monthOffset Int    @default(1)  // which month of the cohort this stage sends in (1-based)
  waitDays    Int    @default(10) // derived business-day gap after the previous stage (engine uses this)

  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@unique([clientId, stageOrder])
}

model Cohort {
  id         String       @id @default(uuid())
  tenantId   String
  clientId   String
  label      String
  monthIndex Int          @default(1)
  status     CohortStatus @default(RUNNING)
  startDate  DateTime     @default(now())
  endedAt    DateTime?
  createdAt  DateTime     @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@index([clientId])
}

model Enrollment {
  id          String           @id @default(uuid())
  tenantId    String
  clientId    String
  cohortId    String
  contactId   String
  stage       Int              @default(0) // 0 = initial; matches SequenceStep.stageOrder
  daySlot     Int              @default(1) // 1..batchWindowDays — preserves day order across stages
  nextTouchAt DateTime
  status      EnrollmentStatus @default(ACTIVE)
  lastSentAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([cohortId, contactId])
  @@index([tenantId])
  @@index([status, nextTouchAt])
}
