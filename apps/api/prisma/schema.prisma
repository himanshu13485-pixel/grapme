// Automated Email Outreach — Prisma schema
// Multi-tenant: every business table carries tenantId for row-level isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  SUPER_ADMIN
  SUB_ADMIN
  USER
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum MailProtocol {
  SMTP
  IMAP
  POP
}

enum MailboxStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

enum ImportStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  DONE
  FAILED
}

enum CampaignStatus {
  DRAFT
  PENDING
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  REJECTED
}

enum StepCondition {
  ALWAYS
  NO_REPLY
  OPENED
  NOT_OPENED
}

enum ScheduleStatus {
  PENDING
  APPROVED
  QUEUED
  SENT
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum EventType {
  SENT
  DELIVERED
  OPEN
  CLICK
  REPLY
  BOUNCE
  UNSUBSCRIBE
  COMPLAINT
}

enum ApprovalEntity {
  CAMPAIGN
  SCHEDULE
  SEQUENCE
  IMPORT
  SMTP
  MESSAGE_DELETE
  CLIENT_DELETE
  CLIENT_ACTIVATION
  LI_CAMPAIGN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SuppressionReason {
  UNSUBSCRIBE
  BOUNCE
  MANUAL
  COMPLAINT
}

enum EnrollmentStatus {
  ACTIVE
  REPLIED
  STOPPED
  COMPLETED
}

enum CohortStatus {
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

// ───────────────────────── Tenancy & Identity ─────────────────────────

model Tenant {
  id              String   @id @default(uuid())
  name            String
  plan            String   @default("free")
  status          String   @default("active")
  settings        Json     @default("{}")
  greetingsEnabled Boolean @default(true) // show a daily login greeting to clients
  reportMailboxId String?  // explicit mailbox client reports are sent from (else auto-resolved)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  emailAccounts   EmailAccount[]
  contactLists    ContactList[]
  contacts        Contact[]
  suppressionList Suppression[]
  importJobs      ImportJob[]
  templates       EmailTemplate[]
  campaigns       Campaign[]
  messages        EmailMessage[]
  approvals       Approval[]
  activityLogs    ActivityLog[]
  creditAccounts  CreditAccount[]
  clients         Client[]
  cohorts         Cohort[]
  enrollments     Enrollment[]
  plans           Plan[]
  greetings       Greeting[]
  assets          Asset[]
}

// Uploaded images (e.g. for email templates), served publicly by id so mail
// clients can load them. Stored in the DB so they persist without a file volume.
model Asset {
  id        String   @id @default(uuid())
  tenantId  String
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Admin-authored "Happy Business" messages shown in the daily client greeting.
model Greeting {
  id        String   @id @default(uuid())
  tenantId  String
  message   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Tenant-defined plan names shown in every plan picker/filter.
model Plan {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  color     String   @default("#0f766e") // theme color for the client portal
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id             String     @id @default(uuid())
  tenantId       String
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  fullAccess     Boolean    @default(false) // sub-admin: access to everything
  accessModules  Json       @default("[]")  // sub-admin: allowed module keys
  canDelete      Boolean    @default(false) // sub-admin: allowed to use delete actions
  profileLimit   Int        @default(1)     // client-portal: how many profiles they may self-create (billable)
  companyName     String?   // client self-registration: their company (prefills New Client form)
  contactMobile   String?   // client self-registration: contact phone (prefills New Client form)
  emailVerified   Boolean   @default(true)  // client self-registration must confirm email before login
  verifyTokenHash String?   // sha256 of the email-confirmation token
  verifyExpires   DateTime? // confirmation-link expiry
  timezone       String     @default("UTC")
  twoFactorSecret String?
  avatarUrl      String?
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions       UserPermission[]
  emailAccounts     EmailAccount[]
  contactLists      ContactList[]
  contacts          Contact[]
  importJobs        ImportJob[]
  templates         EmailTemplate[]
  campaigns         Campaign[]
  ownedClients      Client[]        @relation("ClientOwner")
  creditAccount     CreditAccount?
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  submittedApprovals Approval[] @relation("ApprovalSubmitter")
  reviewedApprovals  Approval[] @relation("ApprovalReviewer")
  activityLogs       ActivityLog[]

  // Sub-admin assignments
  assignmentsAsSubAdmin SubAdminAssignment[] @relation("SubAdmin")
  assignmentsAsUser     SubAdminAssignment[] @relation("AssignedUser")

  @@index([tenantId])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  users       UserPermission[]
}

model UserPermission {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model SubAdminAssignment {
  id               String   @id @default(uuid())
  subAdminId       String
  assignedUserId   String?
  assignedCampaignId String?
  assignedClientId String?
  createdAt        DateTime @default(now())

  subAdmin     User      @relation("SubAdmin", fields: [subAdminId], references: [id], onDelete: Cascade)
  assignedUser User?     @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  campaign     Campaign? @relation(fields: [assignedCampaignId], references: [id], onDelete: Cascade)
  client       Client?   @relation(fields: [assignedClientId], references: [id], onDelete: Cascade)

  @@index([subAdminId])
}

// ───────────────────────── Mailboxes ─────────────────────────

model EmailAccount {
  id                   String        @id @default(uuid())
  tenantId             String
  userId               String
  label                String
  protocol             MailProtocol  @default(SMTP)
  smtpHost             String?
  smtpPort             Int?
  smtpSecure           Boolean       @default(true)
  imapHost             String?
  imapPort             Int?
  emailAddress         String
  smtpUsername         String?       // SMTP login when it differs from the From address (e.g. AWS SES AKIA… user)
  credentialsEncrypted String        // AES-256-GCM blob (SMTP password), never returned to client
  imapUsername         String?       // IMAP login when receiving lives on a different host than SMTP
  imapCredentialsEncrypted String?   // AES-256-GCM blob (IMAP password); falls back to SMTP creds when null
  imapAllowSelfSigned  Boolean       @default(false) // accept self-signed / private-CA IMAP TLS certs
  status               MailboxStatus @default(PENDING)
  dailyLimit           Int           @default(200)
  warmupEnabled        Boolean       @default(true)
  sendSpeedSeconds     Int           @default(90)
  reputationScore      Int           @default(100)
  clientId             String?       // mailbox group: all mailboxes of a client form its sending pool
  rotationOrder        Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaigns Campaign[]
  messages  EmailMessage[]

  @@index([tenantId])
  @@index([userId])
  @@index([clientId])
}

// ───────────────────────── Contacts ─────────────────────────

model ContactList {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  name        String
  description String?
  clientId    String?  // owning client (null = shared/global)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members  ContactListMember[]
  campaigns Campaign[]

  @@index([tenantId])
  @@index([clientId])
}

model Contact {
  id           String        @id @default(uuid())
  tenantId     String
  userId       String
  email        String
  firstName    String?
  lastName     String?
  company      String?
  country      String?
  clientId     String?       // owning client (null = shared/global)
  customFields Json          @default("{}")
  status       ContactStatus @default(ACTIVE)
  dedupeHash   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lists    ContactListMember[]
  messages EmailMessage[]
  enrollments Enrollment[]

  @@unique([tenantId, dedupeHash])
  @@index([tenantId])
  @@index([email])
  @@index([clientId])
}

model ContactListMember {
  id        String @id @default(uuid())
  listId    String
  contactId String

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
}

model Suppression {
  id        String            @id @default(uuid())
  tenantId  String
  email     String
  reason    SuppressionReason
  createdAt DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model ImportJob {
  id         String       @id @default(uuid())
  tenantId   String
  userId     String
  filename   String
  listId     String?      // optional target list applied on approval
  clientId   String?      // owning client, propagated to imported contacts
  totalRows  Int          @default(0)
  validRows  Int          @default(0)
  dupRows    Int          @default(0)
  payload    Json         @default("[]") // staged rows; inserted on approval
  status     ImportStatus @default(PENDING)
  approvalId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ───────────────────────── Templates & Campaigns ─────────────────────────

model EmailTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  variables Json     @default("[]")
  clientId  String?  // owning client (null = shared/global)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaigns Campaign[]
  steps  CampaignStep[]
  sequenceSteps SequenceStep[]

  @@index([tenantId])
  @@index([clientId])
}

model Campaign {
  id              String         @id @default(uuid())
  tenantId        String
  userId          String
  name            String
  clientLabel     String?
  clientId        String?
  emailAccountId  String?
  listId          String?
  templateId      String?
  status          CampaignStatus @default(DRAFT)
  timezone        String         @default("UTC")
  dailyLimit      Int            @default(200)
  sendSpeedSeconds Int           @default(90)
  startAt         DateTime?
  approvalId      String?
  creditsEstimate Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount?  @relation(fields: [emailAccountId], references: [id])
  list         ContactList?   @relation(fields: [listId], references: [id])
  template     EmailTemplate? @relation(fields: [templateId], references: [id])

  steps       CampaignStep[]
  schedules   Schedule[]
  messages    EmailMessage[]
  events      EmailEvent[]
  assignments SubAdminAssignment[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([clientId])
}

model CampaignStep {
  id         String        @id @default(uuid())
  campaignId String
  stepOrder  Int
  templateId String?
  waitDays   Int           @default(0)
  condition  StepCondition @default(ALWAYS)

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id])
  messages EmailMessage[]

  @@unique([campaignId, stepOrder])
}

model Schedule {
  id          String         @id @default(uuid())
  campaignId  String
  scheduledAt DateTime
  timezone    String         @default("UTC")
  status      ScheduleStatus @default(PENDING)
  approvalId  String?
  createdAt   DateTime       @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

// ───────────────────────── Sending & Events ─────────────────────────

model EmailMessage {
  id             String           @id @default(uuid())
  tenantId       String
  campaignId     String?
  cohortId       String?          // GRAPOUT cohort this outbound belongs to (for cohort reports)
  stepId         String?
  contactId      String?
  emailAccountId String?
  direction      MessageDirection @default(OUTBOUND)
  messageId      String?          // RFC Message-ID
  inReplyTo      String?
  fromAddress    String?          // sender address for INBOUND mail
  subject        String?
  body           String?
  status         MessageStatus    @default(QUEUED)
  sentAt         DateTime?
  error          String?
  readAt         DateTime?        // when an INBOUND reply was marked read (null = unread)
  createdAt      DateTime         @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  step         CampaignStep? @relation(fields: [stepId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id])
  events       EmailEvent[]

  @@index([tenantId])
  @@index([campaignId])
  @@index([cohortId])
  @@index([status])
}

model EmailEvent {
  id         String    @id @default(uuid())
  messageId  String
  campaignId String?
  eventType  EventType
  meta       Json      @default("{}")
  occurredAt DateTime  @default(now())

  message  EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  campaign Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
  @@index([eventType])
}

// ───────────────────────── Governance ─────────────────────────

model Approval {
  id             String         @id @default(uuid())
  tenantId       String
  entityType     ApprovalEntity
  entityId       String
  submittedById  String
  status         ApprovalStatus @default(PENDING)
  reviewerId     String?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submittedBy User   @relation("ApprovalSubmitter", fields: [submittedById], references: [id])
  reviewer    User?  @relation("ApprovalReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([entityType, entityId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  occurredAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}

// ───────────────────────── Credits & Notifications ─────────────────────────

model CreditAccount {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String   @unique
  balance       Int      @default(0)
  pricePerEmail Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([tenantId])
}

model CreditTransaction {
  id              String   @id @default(uuid())
  creditAccountId String
  delta           Int
  reason          String
  referenceId     String?
  createdAt       DateTime @default(now())

  creditAccount CreditAccount @relation(fields: [creditAccountId], references: [id], onDelete: Cascade)

  @@index([creditAccountId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── GRAPOUT cohort engine ─────────────────────────
// A Client (end-customer / exporter) owns a mailbox group (EmailAccounts with
// matching clientId) and a sequence. Each month a Cohort of contacts is enrolled
// and dripped: dailyBatchSize/day over batchWindowDays, advancing through the
// sequence steps every stageIntervalDays, rotating across the group's mailboxes.

model Client {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  invoiceNo         String?  // company invoice / account reference
  contactPerson     String?  // client-side point of contact (name)
  email             String?  // client contact email — also the report recipient
  ownerUserId       String?  // client-portal login that owns this profile
  mobile            String?  // client mobile incl. country code
  productCategory   String?  // product / category being exported/imported
  serviceType       String?  // EXPORT | IMPORT | BOTH
  emailEnabled      Boolean  @default(true)  // subscribed to the Email outreach channel
  linkedInEnabled   Boolean  @default(false) // subscribed to the LinkedIn outreach channel
  linkedInCreditMetering Boolean @default(false) // when true, each LinkedIn lead-sourcing run costs 1 credit
  status            String   @default("active")
  plan              String   @default("Growth")
  reportDaily       Boolean  @default(false) // email a daily performance report
  reportWeekly      Boolean  @default(false) // email a weekly report (Mondays)
  reportMonthly     Boolean  @default(false) // email a monthly report (1st)
  reportHour        Int      @default(8)     // hour-of-day to send the report
  reportLastDailyAt   DateTime?              // guards (one send per period)
  reportLastWeeklyAt  DateTime?
  reportLastMonthlyAt DateTime?
  termStartedAt     DateTime @default(now())
  monthlyQuota      Int      @default(100) // fresh contacts per month
  dailyBatchSize    Int      @default(10)  // fresh sends per day
  batchWindowDays   Int      @default(10)  // days to spread a stage across
  stageIntervalDays Int      @default(10)  // gap between sequence stages
  followUpCount     Int      @default(4)   // follow-ups after the initial (capped)
  weekdaysOnly      Boolean  @default(true)
  sendWindowStart   Int      @default(9)    // send only between these hours (human-like)
  sendWindowEnd     Int      @default(17)
  stageIntervalJitterDays Int @default(2)   // ± random days on each follow-up gap
  autoCohortEnabled Boolean  @default(false) // auto-create a monthly cohort
  autoCohortListId  String?                  // source list for auto cohorts
  autoCohortDay     Int      @default(1)      // day-of-month to create it
  lastAutoCohortAt  DateTime?                 // guards once-per-month creation
  validityDays      Int?                      // plan validity window in days (30/180/360)
  validityStartAt   DateTime?                 // when the validity window began
  validityNotifyStage Int    @default(0)      // last expiry-reminder milestone emailed (0..4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User?          @relation("ClientOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  mailboxes     EmailAccount[]
  sequenceSteps SequenceStep[]
  cohorts       Cohort[]
  enrollments   Enrollment[]
  contacts      Contact[]
  contactLists  ContactList[]
  templates     EmailTemplate[]
  campaigns     Campaign[]
  subAdminAssignments SubAdminAssignment[]

  @@index([tenantId])
}

model SequenceStep {
  id         String  @id @default(uuid())
  clientId   String
  cohortId   String? // null = client default template; set = that cohort's own sequence
  stageOrder  Int    // 0 = initial, 1 = FU-1, 2 = FU-2, …
  templateId  String?               // primary variant (= templateIds[0]); kept for back-compat
  templateIds Json   @default("[]") // per-mailbox template variants (index = mailbox rotation position)
  monthOffset Int    @default(1)  // which month of the cohort this stage sends in (1-based)
  waitDays    Int    @default(10) // derived business-day gap after the previous stage (engine uses this)

  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cohort   Cohort?        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  template EmailTemplate? @relation(fields: [templateId], references: [id])

  @@index([clientId])
  @@index([cohortId])
}

model Cohort {
  id         String       @id @default(uuid())
  tenantId   String
  clientId   String
  label      String
  monthIndex Int          @default(1)
  status     CohortStatus @default(RUNNING)
  startDate  DateTime     @default(now())
  endedAt    DateTime?
  createdAt  DateTime     @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  sequenceSteps SequenceStep[]

  @@index([clientId])
}

model Enrollment {
  id          String           @id @default(uuid())
  tenantId    String
  clientId    String
  cohortId    String
  contactId   String
  stage       Int              @default(0) // 0 = initial; matches SequenceStep.stageOrder
  daySlot     Int              @default(1) // 1..batchWindowDays — preserves day order across stages
  nextTouchAt DateTime
  status      EnrollmentStatus @default(ACTIVE)
  lastSentAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([cohortId, contactId])
  @@index([tenantId])
  @@index([status, nextTouchAt])
}

// ═══════════════════════ LinkedIn Outreach channel (additive) ═══════════════════════
// Self-contained module for the LinkedIn channel. It references the shared Tenant /
// Client / User by SCALAR id only (no Prisma relations into them), so no existing model
// or table is modified — this migration is purely additive (CREATE TABLE only).
// All names/enums are Li*-prefixed to avoid colliding with the email models above.

enum LinkedInAccountStatus {
  PENDING       // awaiting Unipile hosted-auth completion
  CONNECTED
  CREDENTIALS   // needs re-auth (cookie expired / checkpoint)
  DISCONNECTED
  ERROR
}

enum LiKnowledgeKind {
  BUSINESS
  STRATEGY
}

enum LiCampaignType {
  AUTOMATIC
  MANUAL
}

enum LiCampaignMode {
  REGULAR
  AI
}

enum LiOutreachType {
  WITH_CONNECTION
  DIRECT_MESSAGES
}

enum LiCampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
  DELETED
}

enum LiStepType {
  CONNECTION_REQUEST
  MESSAGE
}

enum LiLeadStatus {
  PENDING
  CONNECTION_PENDING
  CONNECTED
  MESSAGED
  REPLIED
  BOUNCED
  EXCLUDED
}

enum LiSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum LiMessageDirection {
  INBOUND
  OUTBOUND
}

enum LiMessageSource {
  AUTO
  MANUAL
  AI
}

enum LiScheduledActionType {
  SEND_CONNECTION
  CHECK_ACCEPTANCE
  SEND_MESSAGE
}

enum LiScheduledActionStatus {
  PENDING
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum LiCreditReason {
  AI_FETCH
  LEAD_SOURCING
  TOPUP
  ADJUSTMENT
  REFUND
}

// Separate LinkedIn subscription block for a shared Client — seats / validity / credits
// filled INDEPENDENTLY of the email plan. 1:1 with Client via a unique scalar clientId.
model LinkedInSubscription {
  id              String   @id @default(uuid())
  tenantId        String
  clientId        String   @unique
  planName        String?
  seats           Int      @default(1)
  creditsBalance  Int      @default(0)
  validityDays    Int?
  validityStartAt DateTime?
  whatsappEnabled Boolean  @default(false)
  whatsappNumber  String?
  timezone        String   @default("Asia/Kolkata")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creditTxns LiCreditTransaction[]

  @@index([tenantId])
}

model LiCreditTransaction {
  id             String               @id @default(uuid())
  subscriptionId String
  subscription   LinkedInSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Int
  reason         LiCreditReason
  balanceAfter   Int
  refType        String?
  refId          String?
  note           String?
  createdAt      DateTime             @default(now())

  @@index([subscriptionId])
}

// A LinkedIn "seat" — one connected account (references shared Client by scalar id).
model LinkedInAccount {
  id                String                @id @default(uuid())
  tenantId          String
  clientId          String
  unipileAccountId  String?               @unique
  status            LinkedInAccountStatus @default(PENDING)
  fullName          String?
  headline          String?
  profileUrl        String?
  avatarUrl         String?
  connectionsCount  Int?
  dailyInviteLimit  Int                   @default(20)
  dailyMessageLimit Int                   @default(40)
  lastSyncedAt      DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  campaigns LiCampaign[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model LiKnowledgeProfile {
  id           String          @id @default(uuid())
  tenantId     String
  clientId     String
  kind         LiKnowledgeKind
  parentId     String?
  parent       LiKnowledgeProfile?  @relation("LiKnowledgeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     LiKnowledgeProfile[] @relation("LiKnowledgeHierarchy")
  name         String
  slug         String?
  content      Json            @default("{}")
  completeness Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  messages             LiKnowledgeChatMessage[]
  businessForCampaigns LiCampaign[] @relation("LiCampaignBusiness")
  strategyForCampaigns LiCampaign[] @relation("LiCampaignStrategy")

  @@index([clientId, kind])
  @@index([parentId])
}

model LiKnowledgeChatMessage {
  id        String             @id @default(uuid())
  profileId String
  profile   LiKnowledgeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role      String
  content   String
  fieldKey  String?
  createdAt DateTime           @default(now())

  @@index([profileId])
}

model LiCampaign {
  id                   String           @id @default(uuid())
  tenantId             String
  clientId             String
  linkedInAccountId    String
  linkedInAccount      LinkedInAccount  @relation(fields: [linkedInAccountId], references: [id])
  name                 String
  type                 LiCampaignType   @default(AUTOMATIC)
  mode                 LiCampaignMode   @default(REGULAR)
  outreachType         LiOutreachType   @default(WITH_CONNECTION)
  status               LiCampaignStatus @default(DRAFT)
  timezone             String           @default("Asia/Kolkata")
  run247               Boolean          @default(false)
  workStartHour        Int              @default(9)
  workEndHour          Int              @default(18)
  workDays             Int[]            @default([1, 2, 3, 4, 5])
  dailyConnectionLimit Int              @default(20)
  dailyMessageLimit    Int              @default(20)
  // Warm-up ramp: start low and grow the daily connection cap to the target over
  // warmupDays, to protect the account from LinkedIn's invite limits / bans.
  warmupEnabled        Boolean          @default(true)
  warmupStartLimit     Int              @default(5)   // connections/day on day 0
  warmupDays           Int              @default(14)  // days to reach dailyConnectionLimit
  warmupStartedAt      DateTime?                       // set when the campaign first goes RUNNING
  businessProfileId    String?
  businessProfile      LiKnowledgeProfile? @relation("LiCampaignBusiness", fields: [businessProfileId], references: [id])
  strategyId           String?
  strategy             LiKnowledgeProfile? @relation("LiCampaignStrategy", fields: [strategyId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  audienceSpec LiTargetAudienceSpec?
  steps        LiSequenceStep[]
  leads        LiLead[]

  @@index([tenantId])
  @@index([clientId, status])
  @@index([linkedInAccountId])
}

model LiTargetAudienceSpec {
  id                     String     @id @default(uuid())
  campaignId             String     @unique
  campaign               LiCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  countries              String[]   @default([])
  cities                 String[]   @default([])
  industries             String[]   @default([])
  companySizes           String[]   @default([])
  departments            String[]   @default([])
  jobTitles              String[]   @default([])
  seniorities            String[]   @default([])
  companyKeywordsInclude String[]   @default([])
  companyKeywordsExclude String[]   @default([])
  personKeywordsInclude  String[]   @default([])
  personKeywordsExclude  String[]   @default([])
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
}

model LiSequenceStep {
  id         String     @id @default(uuid())
  campaignId String
  campaign   LiCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order      Int
  type       LiStepType
  waitHours  Int        @default(0)
  body       String?
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([campaignId, order])
  @@index([campaignId])
}

model LiLead {
  id              String       @id @default(uuid())
  campaignId      String
  campaign        LiCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fullName        String
  firstName       String?
  lastName        String?
  title           String?
  company         String?
  location        String?
  profileUrl      String?
  avatarUrl       String?
  unipileMemberId String?
  status          LiLeadStatus @default(PENDING)
  currentStep     Int          @default(0)
  sentiment       LiSentiment?
  intent          String?
  connectedAt     DateTime?
  lastActionAt    DateTime?
  lastReplyAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  conversation LiConversation?
  aiFetches    LiAiFetch[]
  scheduled    LiScheduledAction[]

  @@index([campaignId, status])
  @@index([status])
}

model LiConversation {
  id            String      @id @default(uuid())
  leadId        String      @unique
  lead          LiLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  unipileChatId String?     @unique
  unreadCount   Int         @default(0)
  needsReply    Boolean     @default(false)
  lastReplyAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages LiMessage[]

  @@index([needsReply])
}

model LiMessage {
  id               String             @id @default(uuid())
  conversationId   String
  conversation     LiConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction        LiMessageDirection
  source           LiMessageSource    @default(AUTO)
  body             String
  unipileMessageId String?            @unique
  sentAt           DateTime           @default(now())
  createdAt        DateTime           @default(now())

  @@index([conversationId])
}

model LiAiFetch {
  id         String       @id @default(uuid())
  leadId     String
  lead       LiLead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  intent     String?
  sentiment  LiSentiment?
  enrichment Json?
  draftReply String?
  creditCost Int          @default(1)
  createdAt  DateTime     @default(now())

  @@index([leadId])
}

model LiScheduledAction {
  id        String                  @id @default(uuid())
  leadId    String
  lead      LiLead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LiScheduledActionType
  status    LiScheduledActionStatus @default(PENDING)
  stepOrder Int?
  runAt     DateTime
  jobId     String?
  attempts  Int                     @default(0)
  lastError String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([status, runAt])
  @@index([leadId])
}
