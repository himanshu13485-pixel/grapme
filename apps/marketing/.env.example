# Marketing site (grapme.com) — copy to .env.local for local development.

# Where the "Log in / Sign up / Get started" CTAs point (client-side link).
# Local dev: point at your local app instead of production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API base for the server-side live-plans fetch on /pricing (runtime, not public).
# Local dev default is http://localhost:4000/api/v1 if unset.
API_URL=http://localhost:4000/api/v1

# Public site origin (canonical URLs / metadata). Defaults to https://www.grapme.com.
# NEXT_PUBLIC_SITE_URL=http://localhost:3200
