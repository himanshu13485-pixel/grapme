# ─── Production environment (used by docker-compose.prod.yml) ───
# deploy.sh generates a real .env from this. To do it by hand, copy to .env and
# fill every value below.

# Public address of your server. Use https URLs if you put it behind TLS
# (Caddy/nginx). If you only have an IP, use http://<IP>:<port>.
WEB_PUBLIC_URL=http://YOUR_SERVER_IP:3000
APP_PUBLIC_URL=http://YOUR_SERVER_IP:4000
# The browser calls the API at this URL — must be reachable from the user's
# browser (baked into the web bundle at build time).
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000/api/v1

# PostgreSQL password (container-internal). Use a long random value.
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Auth secrets — REQUIRED and must be strong (the API refuses to boot otherwise).
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# Credential encryption key — 32 bytes, base64:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# Public "create a new admin workspace" signup. Leave true for first-run so you
# can create your admin, then set to false and restart to lock it down.
ALLOW_ADMIN_SIGNUP=true
